# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=闲小宝二手交易平台
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
APP_VERSION=0.2.0
API_PREFIX=                     # set to "/api/v1" to version the public surface
DOCS_ENABLED=true               # disable /docs, /redoc in production if you like

# ---------------------------------------------------------------------------
# Database (async driver is mandatory)
# ---------------------------------------------------------------------------
# Local dev can use SQLite; production must use PostgreSQL + pgvector.
DATABASE_URL=sqlite+aiosqlite:///./test.db
# DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5432/mydb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_PRE_PING=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis (optional but strongly recommended)
# ---------------------------------------------------------------------------
# Without Redis the app still serves traffic: idempotency, rate limiting, thread
# locks and SSE replay fall back to in-process implementations (single replica).
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=1.0
# true -> /health/ready fails when Redis is unreachable (use in production)
REDIS_REQUIRED=false
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# REQUIRED outside development/test, >= 32 chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160
JWT_ISSUER=xianxiaobao
JWT_AUDIENCE=xianxiaobao-api
# Allow anonymous callers to self-register as admin (NEVER enable in production).
ALLOW_PUBLIC_ROLE_SELECTION=false

# ---------------------------------------------------------------------------
# LLM gateway (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
CHAT_API_KEY=
API_KEY=                         # legacy alias, read only if CHAT_API_KEY is empty
CHAT_BASE_URL=https://api.zetatechs.com/v1
CHAT_MODEL=gemini-3-flash-preview-free
ALLOWED_CHAT_MODELS=gemini-3-flash-preview-free
LLM_MAX_CONCURRENCY=32
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_TIMEOUT_SECONDS=120

# Embeddings (Zhipu embedding-2, 1024 dims; used for semantic search)
ZHIPUAI_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-2
ALLOWED_EMBEDDING_MODELS=embedding-2
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_DIMENSION=1024
EMBEDDING_ENABLED=true

# ---------------------------------------------------------------------------
# Agent / SSE
# ---------------------------------------------------------------------------
AGENT_RUNTIME=native             # native | langgraph (requires langgraph installed)
AGENT_MAX_STEPS=6
# Orders above this amount require human approval (HITL).
AGENT_APPROVAL_THRESHOLD=1000
AGENT_APPROVAL_TTL_HOURS=24
AGENT_CONTEXT_MESSAGES=8
AGENT_STREAM_TTL_SECONDS=600
AGENT_STREAM_MAXLEN=2000
AGENT_THREAD_LOCK_TTL=30
AGENT_STREAM_HEARTBEAT_SECONDS=15
# continue: finish the run + persist after a client disconnect (stateful flows)
# abort:    cancel the upstream stream immediately (save tokens)
AGENT_DISCONNECT_POLICY=continue
AGENT_CLEANUP_INTERVAL_SECONDS=3600
LANGGRAPH_ENABLED=false
POSTGRES_RAW_DSN=                 # psycopg3 DSN, only for the LangGraph checkpointer
CHECKPOINTER_POOL_MIN=2
CHECKPOINTER_POOL_MAX=10

# ---------------------------------------------------------------------------
# Feishu (Lark) bot
# ---------------------------------------------------------------------------
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_TIMEOUT_SECONDS=10
FEISHU_RATE_LIMIT_PER_MINUTE=3
FEISHU_BIND_URL_BASE=http://localhost:5173/bind-feishu

# ---------------------------------------------------------------------------
# Uploads / media
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
STATIC_DIR=static
MAX_UPLOAD_BYTES=10485760       # 10 MiB
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
STORAGE_BACKEND=local           # local | cloud
STORAGE_UPLOAD_URL=             # required when STORAGE_BACKEND=cloud
PUBLIC_BASE_URL=
VISION_ENABLED=true             # set false to skip loading the CN-CLIP model
VISION_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
VISION_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# HTTP middleware
# ---------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=5
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
# Must be false in production (start-up fails otherwise).
CORS_ALLOW_ALL_IN_DEV=true
MAX_REQUEST_BYTES=1048576
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | text
LOG_ACCESS_EXCLUDE=/health,/health/live,/health/ready,/favicon.ico,/docs,/redoc,/openapi.json

# ---------------------------------------------------------------------------
# Async task queue (replaces Celery)
# ---------------------------------------------------------------------------
TASKS_ENABLED=true
TASKS_EAGER=false               # true -> run tasks in-process (tests/dev)
TASKS_STREAM=xianxiaobao:tasks
TASKS_GROUP=workers
TASKS_MAX_ATTEMPTS=3
TASKS_BACKOFF_SECONDS=2
TASKS_VISIBILITY_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Idempotency / rate limiting
# ---------------------------------------------------------------------------
# true -> every guarded write endpoint requires X-Idempotency-Key (strict mode,
# recommended in production; the frontend must then send a UUID per action).
IDEMPOTENCY_HEADER_REQUIRED=false
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_TTL_SECONDS=120
RATE_LIMIT_ENABLED=true
